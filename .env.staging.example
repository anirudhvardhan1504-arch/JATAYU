# ==============================================================================
# JATAYU Staging Environment Configuration Template (.env.staging)
# Copy this file to .env before starting the container stack via Docker Compose.
# ==============================================================================

# Reverse Proxy Port Mapping on Host (Default: http://localhost:8080)
PORT_HTTP=8080

# Production Runtime Mode
NODE_ENV=production

# Mandatory Security Secrets (Must be at least 32 characters in production)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_staging_jwt_secret_must_be_at_least_32_characters_long
JWT_TTL_SECONDS=900

# CORS Allowed Origins (Comma-separated list; wildcards forbidden in production)
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

# System Administrator Initial Provisioning Key (Optional if already provisioned)
PROVISIONING_KEY=your_staging_admin_provisioning_key_at_least_32_chars

# External AI Service (Optional during staging)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet:beta

# External Meteorology Base URL (Default: Open-Meteo)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
