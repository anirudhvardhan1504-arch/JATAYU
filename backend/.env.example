# ==============================================================================
# JATAYU Backend Environment Configuration (Example)
# Copy this file to backend/.env for local development.
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Authentication & RBAC Secrets
# Minimum 32-character cryptographically secure secret
JWT_SECRET=super_secret_jwt_key_at_least_32_chars_long_jatayu_2026
JWT_TTL_SECONDS=3600
JATAYU_AUTH_DB=data/jatayu_auth.db
PROVISIONING_KEY=super_secret_provisioning_key_at_least_32_characters_long
TRUST_PROXY=false

# Demo Provisioning Credentials
DEMO_ADMIN_PASSWORD=AdminDemo2026!
DEMO_RESEARCHER_PASSWORD=Researcher2026!

# OpenRouter AI Gateway (Optional for prototype; required for live generative SITREPs)
# Obtain key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet:beta

# Meteorology & Hydrometeorological Feeds
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Routing & Reverse Geocoding Gateways (Public defaults used if empty)
OSRM_BACKEND_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ISRO / MOSDAC Satellite Credentials (Optional for INSAT-3DR satellite overlay)
MOSDAC_USER=
MOSDAC_PASSWORD=
