{
  "name": "jatayu-backend",
  "version": "0.1.0",
  "description": "JATAYU Disaster Intelligence Platform — Server & APIs",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm run copy:assets",
    "copy:assets": "node scripts/copy_assets.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "provision:admin": "tsx scripts/provision-admin.ts",
    "provision:demo-researcher": "node dist/scripts/provision_demo_researcher.js"
  },
  "dependencies": {
    "@types/shapefile": "^0.6.4",
    "@types/which-polygon": "^2.2.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.11.2",
    "shapefile": "^0.6.6",
    "which-polygon": "^2.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
