# ==============================================================================
# JATAYU Platform Environment Configuration (Example)
# Copy this file to .env in backend/ or root for local development.
# NEVER commit real API keys or sensitive credentials into source control.
# ==============================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
# CORS_ORIGIN: Comma-separated list of allowed browser origins (Required in production, no wildcards)
# e.g., in production: CORS_ORIGIN=https://jatayu.defense.gov.in,https://console.jatayu.defense.gov.in
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Authentication & Security Configuration
# JWT_SECRET: Cryptographically secure secret of at least 32 characters (Required in production)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_TTL_SECONDS=900
JATAYU_AUTH_DB=data/jatayu_auth.db
PROVISIONING_KEY=your_admin_provisioning_key_at_least_32_characters_long
TRUST_PROXY=false

# OpenRouter AI API (Required for production AI features, optional during Phase 1 scaffolding)
# Get a key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet:beta

# Weather Provider Configuration (Open-Meteo does not require an API key for prototype use)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Frontend Configuration (Injected at build/runtime)
VITE_API_BASE_URL=http://localhost:5000/api
