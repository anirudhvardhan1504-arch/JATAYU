# ==============================================================================
# JATAYU Platform Environment Configuration (Example)
# Copy this file to .env in backend/ or root for local development.
# NEVER commit real API keys or sensitive credentials into source control.
# ==============================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
# CORS_ORIGIN: Comma-separated list of allowed browser origins (Required in production, no wildcards)
# e.g., in production: CORS_ORIGIN=https://jatayu.defense.gov.in,https://console.jatayu.defense.gov.in
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Authentication & Security Configuration
# JWT_SECRET: Cryptographically secure secret of at least 32 characters (Required in production)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_TTL_SECONDS=900
JATAYU_AUTH_DB=data/jatayu_auth.db
PROVISIONING_KEY=your_admin_provisioning_key_at_least_32_characters_long
TRUST_PROXY=false

# OpenRouter AI API (Required for production AI features, optional during Phase 1 scaffolding)
# Get a key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet:beta

# Weather Provider Configuration (Open-Meteo does not require an API key for prototype use)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ==============================================================================
# Geospatial Provider Configuration (Phase 4C.1 Production Setup)
# ==============================================================================
# Cesium ion Access Token (Required for 3D terrain elevation and Bing Aerial imagery)
# Free community token (50,000 monthly views): https://ion.cesium.com/tokens
VITE_CESIUM_ION_ACCESS_TOKEN=

# Esri ArcGIS Location Platform API Key (Optional for prototype; required for production high-volume SLA)
# Free developer tier (20,000 transactions/mo): https://developers.arcgis.com/
VITE_ARCGIS_API_KEY=

# CARTO Basemap API Key (Optional; removes the 'CARTO API KEY REQUIRED' watermark on raster tiles)
# Register at: https://carto.com/
VITE_CARTO_API_KEY=

# RainViewer API Key (Optional for basic 2-hour nowcast; required for commercial SLA & 2-hour forecast)
# Documentation: https://www.rainviewer.com/api.html
VITE_RAINVIEWER_API_KEY=

# ISRO / MOSDAC Satellite Credentials (For INSAT-3D/3DR/3DS Rapid Scan meteorological products)
# Register at: https://mosdac.gov.in/
VITE_MOSDAC_API_KEY=
MOSDAC_USER=
MOSDAC_PASSWORD=

# Frontend Configuration (Injected at build/runtime)
VITE_API_BASE_URL=http://localhost:5000/api
