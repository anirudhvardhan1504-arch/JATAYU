# ==============================================================================
# JATAYU Platform Environment Configuration (Example)
# Copy this file to .env in root or workspace folders for local development.
# NEVER commit real API keys or sensitive credentials into source control.
# ==============================================================================

# Backend Server Configuration
PORT=5001
NODE_ENV=development
# CORS_ORIGIN: Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Authentication & Security Configuration
# JWT_SECRET: Cryptographically secure secret of at least 32 characters
JWT_SECRET=super_secret_jwt_key_at_least_32_chars_long_jatayu_2026
JWT_TTL_SECONDS=3600
JATAYU_AUTH_DB=data/jatayu_auth.db
PROVISIONING_KEY=super_secret_provisioning_key_at_least_32_characters_long
TRUST_PROXY=false

# Demo Role Accounts
DEMO_ADMIN_PASSWORD=AdminDemo2026!
DEMO_RESEARCHER_PASSWORD=Researcher2026!

# OpenRouter AI API (Optional for prototype; required for live generative SITREPs)
# Get a key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet:beta

# Weather Provider Configuration (Open-Meteo does not require an API key for standard use)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Routing & Geocoding Gateways
OSRM_BACKEND_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ==============================================================================
# Geospatial Provider Configuration (Frontend Client Keys)
# ==============================================================================
# Cesium ion Access Token (Required for 3D terrain elevation and Bing Aerial imagery)
# Free community token: https://ion.cesium.com/tokens
VITE_CESIUM_ION_ACCESS_TOKEN=

# Esri ArcGIS Location Platform API Key (Optional for prototype; required for high-volume SLA)
# Free developer tier: https://developers.arcgis.com/
VITE_ARCGIS_API_KEY=

# CARTO Basemap API Key (Optional; removes the watermark on raster tiles)
# Register at: https://carto.com/
VITE_CARTO_API_KEY=

# RainViewer API Key (Optional for basic nowcast; required for commercial SLA & 2-hour forecast)
# Documentation: https://www.rainviewer.com/api.html
VITE_RAINVIEWER_API_KEY=

# ISRO / MOSDAC Satellite Credentials (For INSAT-3D/3DR/3DS Rapid Scan meteorological products)
# Register at: https://mosdac.gov.in/
VITE_MOSDAC_API_KEY=
MOSDAC_USER=
MOSDAC_PASSWORD=

# Frontend Configuration (Injected at build/runtime)
VITE_API_BASE_URL=http://localhost:5001/api
